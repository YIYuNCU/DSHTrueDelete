{
  "name": "dsh-true-delete",
  "version": "0.2.0",
  "description": "DSH 桌面端插件：给「已归档」的会话在右键菜单里加一个删除项，二次确认后删除它在本机的日志与缓存文件。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "archive",
    "cleanup",
    "delete"
  ],
  "type": "module",
  "main": "lib/index.js",
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "test": "node test/host.test.mjs && node test/client.test.mjs",
    "test:host": "node test/host.test.mjs",
    "test:client": "node test/client.test.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  }
}
